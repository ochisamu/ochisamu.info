---
import { formatDate, tagSlug } from "../utils"

interface Props {
  date: Date
  tags: string[]
  tone?: "light" | "dark"
}

const { date, tags, tone = "light" } = Astro.props
const metaClass =
  tone === "dark"
    ? "mb-3 flex flex-wrap gap-3 text-sm font-medium text-slate-300"
    : "mb-3 flex flex-wrap gap-3 text-sm font-medium text-slate-500"
const tagClass =
  tone === "dark"
    ? "inline-flex min-h-7 items-center rounded-full border border-white/20 bg-white/10 px-2.5 text-xs font-bold text-white no-underline transition hover:border-teal-200 hover:bg-white/20"
    : "relative z-20 inline-flex min-h-7 items-center rounded-full border border-slate-200 bg-slate-50 px-2.5 text-xs font-bold text-slate-600 no-underline transition hover:border-rose-200 hover:bg-rose-50 hover:text-rose-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-rose-200"
---

<div class={metaClass}>
  <span class="inline-flex items-center gap-1.5">
    <svg
      class="size-4 fill-none stroke-current stroke-[1.9]"
      aria-hidden="true"
      viewBox="0 0 24 24"
    >
      <path
        d="M8 2v3M16 2v3M3.5 9.1h17M5.5 4.5h13a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2v-12a2 2 0 0 1 2-2Z"
      ></path>
    </svg>
    {formatDate(date)}
  </span>
</div>
<div class="flex flex-wrap gap-2">
  {
    tags.map(tag => (
      <a class={tagClass} href={`/tags/${tagSlug(tag)}/`}>
        #{tag}
      </a>
    ))
  }
</div>
