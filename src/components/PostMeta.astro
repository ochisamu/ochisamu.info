---
import { formatDate, tagSlug } from "../utils"

interface Props {
  date: Date
  updated?: Date
  tags: string[]
  tone?: "light" | "dark"
}

const { date, updated, tags, tone = "light" } = Astro.props
const metaClass =
  tone === "dark"
    ? "mb-3 flex flex-wrap gap-3 text-sm font-medium text-[#e8e1cf]"
    : "mb-3 flex flex-wrap gap-3 text-sm font-medium text-[var(--muted)]"
const tagClass =
  tone === "dark"
    ? "inline-flex min-h-7 items-center rounded-md border border-white/25 bg-white/10 px-2.5 text-xs font-bold text-white no-underline transition hover:border-[var(--marker)] hover:bg-white/20"
    : "relative z-20 inline-flex min-h-7 items-center rounded-md border border-[var(--rule)] bg-[var(--paper)] px-2.5 text-xs font-bold text-[var(--muted)] no-underline transition hover:border-[var(--hot)] hover:bg-[var(--marker)] hover:text-[var(--ink)] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[var(--marker)]"
---

<div class={metaClass}>
  <span class="inline-flex items-center gap-1.5">
    <svg
      class="size-4 fill-none stroke-current stroke-[1.9]"
      aria-hidden="true"
      viewBox="0 0 24 24"
    >
      <path
        d="M8 2v3M16 2v3M3.5 9.1h17M5.5 4.5h13a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2v-12a2 2 0 0 1 2-2Z"
      ></path>
    </svg>
    公開 {formatDate(date)}
  </span>
  {
    updated && (
      <span class="inline-flex items-center gap-1.5">
        <svg
          class="size-4 fill-none stroke-current stroke-[1.9]"
          aria-hidden="true"
          viewBox="0 0 24 24"
        >
          <path d="M4 12a8 8 0 0 1 13.7-5.6L20 8.7M20 4.5v4.2h-4.2M20 12a8 8 0 0 1-13.7 5.6L4 15.3M4 19.5v-4.2h4.2" />
        </svg>
        更新 {formatDate(updated)}
      </span>
    )
  }
</div>
<div class="flex flex-wrap gap-2">
  {
    tags.map(tag => (
      <a class={tagClass} href={`/tags/${tagSlug(tag)}/`}>
        #{tag}
      </a>
    ))
  }
</div>
