---
interface Props {
  type?: "index" | "post"
  tags: string[]
}

const { type = "post", tags } = Astro.props
const isIndex = type === "index"
const isGatsby = tags.includes("Gatsby")
const isKeyboard = tags.includes("Keyboard")
const kind = isGatsby ? "gatsby" : isKeyboard ? "keyboard" : "default"
const background =
  kind === "keyboard"
    ? "from-indigo-100 via-slate-100 to-violet-100 text-indigo-800"
    : kind === "gatsby"
      ? "from-cyan-100 via-sky-100 to-teal-100 text-cyan-800"
      : "from-rose-100 via-pink-50 to-orange-100 text-rose-800"
---

<div
  class:list={[
    "grid place-items-center bg-gradient-to-br",
    background,
    isIndex
      ? "aspect-[16/10] w-full"
      : "min-h-48 w-full rounded-2xl sm:min-h-60",
  ]}
>
  {
    kind === "keyboard" ? (
      <svg
        class:list={[
          isIndex ? "size-14" : "size-28",
          "fill-none stroke-current stroke-[1.8]",
        ]}
        aria-hidden="true"
        viewBox="0 0 24 24"
      >
        <path d="M4 7.5h16v9H4z" />
        <path d="M7 10h.01M10 10h.01M13 10h.01M16 10h.01M7 13h10" />
      </svg>
    ) : kind === "gatsby" ? (
      <svg
        class:list={[
          isIndex ? "size-14" : "size-28",
          "fill-none stroke-current stroke-[1.8]",
        ]}
        aria-hidden="true"
        viewBox="0 0 24 24"
      >
        <circle cx="12" cy="12" r="2.2" />
        <path d="M12 4.5c4.8 0 8.7 3.4 8.7 7.5s-3.9 7.5-8.7 7.5S3.3 16.1 3.3 12 7.2 4.5 12 4.5Z" />
        <path d="M5.5 8.3c2.4-4.2 7.5-5.9 11.1-3.8 3.6 2.1 4.4 7.3 2 11.5s-7.5 5.9-11.1 3.8c-3.6-2.1-4.4-7.3-2-11.5Z" />
        <path d="M18.5 8.3c2.4 4.2 1.6 9.4-2 11.5-3.6 2.1-8.7.4-11.1-3.8s-1.6-9.4 2-11.5c3.6-2.1 8.7-.4 11.1 3.8Z" />
      </svg>
    ) : (
      <svg
        class:list={[
          isIndex ? "size-14" : "size-28",
          "fill-none stroke-current stroke-[1.8]",
        ]}
        aria-hidden="true"
        viewBox="0 0 24 24"
      >
        <path d="M7 8.5h10M7 12h7M7 15.5h5" />
        <path d="M5.5 3.5h13a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2v-13a2 2 0 0 1 2-2Z" />
      </svg>
    )
  }
</div>
