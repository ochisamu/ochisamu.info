---
import type { BlogPost } from "../utils"
import { postHref, postSlug } from "../utils"
import EyeCatch from "./EyeCatch.astro"
import PostMeta from "./PostMeta.astro"

interface Props {
  posts: BlogPost[]
}

const { posts } = Astro.props
---

<ol class="grid min-w-0 list-none gap-5 p-0 md:grid-cols-2 xl:grid-cols-3">
  {
    posts.map((post, index) => (
      <li class="m-0 min-w-0">
        <article
          class="group isolate relative grid h-full min-w-0 grid-rows-[auto_1fr] overflow-hidden rounded-lg border border-[var(--ink)] bg-[var(--paper-soft)] shadow-[5px_5px_0_rgba(24,23,20,0.12)] transition duration-200 hover:-translate-y-1 hover:shadow-[8px_8px_0_rgba(24,23,20,0.16)] focus-within:-translate-y-1 focus-within:shadow-[8px_8px_0_rgba(24,23,20,0.16)]"
          itemscope
          itemtype="http://schema.org/Article"
        >
          <a
            class="absolute inset-0 z-10 rounded-lg no-underline outline-none focus-visible:ring-4 focus-visible:ring-[var(--marker)]"
            href={postHref(post)}
            itemprop="url"
            aria-label={`${post.data.title} を読む`}
          >
            <span class="sr-only">{post.data.title} を読む</span>
          </a>
          <EyeCatch
            type="index"
            tags={post.data.tags}
            title={post.data.title}
            slug={postSlug(post)}
          />
          <header class="p-5">
            <p class="mb-3 text-xs font-black uppercase tracking-[0.18em] text-[var(--accent-dark)]">
              Note {String(index + 1).padStart(2, "0")}
            </p>
            <h2 class="mb-3 mt-0 font-serif text-lg font-black leading-tight tracking-normal text-[var(--ink)] sm:text-xl">
              <span
                class="transition group-hover:text-[var(--hot)] group-focus-within:text-[var(--hot)]"
                itemprop="headline"
              >
                {post.data.title}
              </span>
            </h2>
            <PostMeta
              date={post.data.date}
              updated={post.data.updated}
              tags={post.data.tags}
            />
            {post.data.description && (
              <p class="mt-4 line-clamp-2 text-sm leading-6 text-[var(--muted)]">
                {post.data.description}
              </p>
            )}
            <div
              class="mt-5 inline-flex items-center gap-2 text-sm font-black text-[var(--hot)] transition group-hover:gap-3 group-focus-within:gap-3"
              aria-hidden="true"
            >
              読む
              <svg
                class="size-4 fill-none stroke-current stroke-2"
                viewBox="0 0 24 24"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </div>
          </header>
        </article>
      </li>
    ))
  }
</ol>
