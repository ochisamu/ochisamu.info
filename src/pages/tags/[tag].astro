---
import { getCollection } from "astro:content"
import Base from "../../layouts/Base.astro"
import Bio from "../../components/Bio.astro"
import PostList from "../../components/PostList.astro"
import { allTags, byDateDesc, tagSlug } from "../../utils"

export async function getStaticPaths() {
  const posts = await getCollection("blog")
  return allTags(posts).map(tag => ({
    params: { tag: tagSlug(tag) },
    props: { tag },
  }))
}

const { tag } = Astro.props
const posts = (await getCollection("blog"))
  .filter(post => post.data.tags.includes(tag))
  .sort(byDateDesc)
---

<Base title={`Tags: ${tag}`}>
  <div class="mb-10">
    <Bio />
  </div>
  <section class="mb-8 border-l-4 border-[var(--ink)] pl-5">
    <p class="mb-3 text-xs font-black uppercase tracking-[0.18em] text-[var(--accent-dark)]">
      Tagged notes
    </p>
    <h1 class="font-serif text-3xl font-black text-[var(--ink)] sm:text-5xl">
      {tag} ({posts.length}件)
    </h1>
  </section>
  <PostList posts={posts} />
</Base>
