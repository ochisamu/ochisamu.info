---
import { getCollection } from "astro:content"
import Base from "../../layouts/Base.astro"
import { allTags, tagSlug } from "../../utils"

const posts = await getCollection("blog")
const tags = allTags(posts).map(tag => ({
  name: tag,
  count: posts.filter(post => post.data.tags.includes(tag)).length,
}))
---

<Base title="Tags">
  <section class="mb-10 max-w-4xl border-l-4 border-[var(--ink)] py-5 pl-5">
    <p
      class="mb-4 text-xs font-black uppercase tracking-[0.18em] text-[var(--accent-dark)]"
    >
      Tags
    </p>
    <h1
      class="mb-5 text-balance font-serif text-4xl font-black leading-tight tracking-normal text-[var(--ink)] sm:text-6xl"
    >
      タグ一覧
    </h1>
    <p class="max-w-2xl text-lg leading-8 text-[var(--muted)]">
      興味のあるテーマから記事を探せます。
    </p>
  </section>

  <ul class="grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
    {
      tags.map(tag => (
        <li class="m-0">
          <a
            class="flex min-h-24 items-center justify-between rounded-lg border border-[var(--ink)] bg-[var(--paper-soft)] p-5 text-[var(--ink)] no-underline shadow-[4px_4px_0_rgba(24,23,20,0.12)] transition hover:-translate-y-1 hover:text-[var(--hot)] hover:shadow-[7px_7px_0_rgba(24,23,20,0.16)]"
            href={`/tags/${tagSlug(tag.name)}/`}
          >
            <span class="text-lg font-black">#{tag.name}</span>
            <span class="rounded-md bg-[var(--marker)] px-3 py-1 text-sm font-black text-[var(--ink)]">
              {tag.count}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
