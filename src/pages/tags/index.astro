---
import { getCollection } from "astro:content"
import Base from "../../layouts/Base.astro"
import { allTags, tagSlug } from "../../utils"

const posts = await getCollection("blog")
const tags = allTags(posts).map(tag => ({
  name: tag,
  count: posts.filter(post => post.data.tags.includes(tag)).length,
}))
---

<Base title="Tags">
  <section class="mb-10 max-w-4xl py-5 text-white">
    <p
      class="mb-4 text-xs font-black uppercase tracking-[0.18em] text-teal-200"
    >
      Tags
    </p>
    <h1
      class="mb-5 text-balance text-4xl font-black leading-tight tracking-normal sm:text-6xl"
    >
      タグ一覧
    </h1>
    <p class="max-w-2xl text-lg leading-8 text-slate-300">
      興味のあるテーマから記事を探せます。
    </p>
  </section>

  <ul class="grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
    {
      tags.map(tag => (
        <li class="m-0">
          <a
            class="flex min-h-24 items-center justify-between rounded-2xl border border-slate-200 bg-white p-5 text-slate-950 no-underline shadow-sm transition hover:-translate-y-1 hover:border-rose-200 hover:text-rose-700 hover:shadow-2xl hover:shadow-slate-900/10"
            href={`/tags/${tagSlug(tag.name)}/`}
          >
            <span class="text-lg font-black">#{tag.name}</span>
            <span class="rounded-full bg-slate-100 px-3 py-1 text-sm font-black text-slate-500">
              {tag.count}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
