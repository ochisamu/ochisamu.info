---
import { getCollection } from "astro:content"
import Base from "../layouts/Base.astro"
import Bio from "../components/Bio.astro"
import PostList from "../components/PostList.astro"
import { byDateDesc } from "../utils"

const posts = (await getCollection("blog")).sort(byDateDesc)
---

<Base title="All posts">
  <section
    class="mb-8 max-w-3xl border-l-4 border-[var(--ink)] py-3 pl-5 sm:mb-10"
  >
    <p class="mb-3 text-xs font-black uppercase tracking-[0.18em] text-[var(--accent-dark)]">
      Recent notes
    </p>
    <h1 class="mb-3 text-balance font-serif text-3xl font-black leading-tight tracking-normal text-[var(--ink)] sm:text-4xl">
      読んだ記事、試したこと、あとで見返すメモ
    </h1>
    <p class="max-w-2xl text-base leading-7 text-[var(--muted)] sm:text-lg">
      週次 Tech Clips、開発ログ、自作キーボードまわりの記録を短く残しています。
    </p>
  </section>
  <div class="mb-10">
    <Bio />
  </div>
  <PostList posts={posts} />
</Base>
