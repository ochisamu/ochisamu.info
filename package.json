{
  "name": "ochisamu-info",
  "private": true,
  "description": "ochisamu.info built with Astro",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "start": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "preview:cloudflare": "npm run build && wrangler dev",
    "format": "prettier --write \"**/*.{astro,js,ts,json,md,css}\""
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource/noto-sans-jp": "^5.1.1",
    "astro": "^6.1.10",
    "mermaid": "^11.14.0",
    "sharp": "^0.33.5"
  },
  "overrides": {
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.2.4",
    "wrangler": "^4.86.0"
  }
}
